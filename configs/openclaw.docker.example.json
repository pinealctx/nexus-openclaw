{
  "agents": {
    "defaults": {
      "model": "anthropic/claude-sonnet-4"
    }
  },
  "gateway": {
    "bind": "lan",
    "controlUi": {
      "allowedOrigins": ["http://localhost:18789", "http://127.0.0.1:18789", "http://0.0.0.0:18789"]
    }
  },
  "channels": {
    "nexus": {
      "enabled": true,
      "accounts": {
        "default": {
          "serverUrl": "http://server:8080",
          "agentToken": "nxa_your_token_here",
          "deliveryMode": "websocket",
          "gatewayUrl": "ws://gateway:8444/ws/agent"
        }
      }
    }
  },
  "plugins": {
    "enabled": true,
    "load": {
      "paths": ["/opt/nexus-openclaw"]
    }
  }
}
