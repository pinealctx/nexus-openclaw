{
  "name": "nexus-openclaw",
  "version": "0.1.0",
  "description": "OpenClaw channel plugin for Nexus AI IM platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dock": {
      "import": "./dist/dock.js",
      "types": "./dist/dock.d.ts"
    }
  },
  "scripts": {
    "generate": "cd ../nexus-ai/proto && buf generate --template ../../nexus-openclaw/buf.gen.ts.yaml --include-imports -o ../../nexus-openclaw",
    "build": "tsc",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "openclaw": {
    "extensions": ["channel:nexus"]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pinealctx/nexus-openclaw.git"
  },
  "homepage": "https://github.com/pinealctx/nexus-openclaw",
  "bugs": {
    "url": "https://github.com/pinealctx/nexus-openclaw/issues"
  },
  "keywords": [
    "openclaw",
    "nexus-ai",
    "channel-plugin",
    "im",
    "agent",
    "websocket",
    "streaming"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "vitest": "^3.2.1",
    "fast-check": "^4.1.1",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
